# ---------------------------------------------------------------------------
# AI Video Director - environment template
# Copy to .env and fill in values. Never commit .env.
# ---------------------------------------------------------------------------

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Web (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- API (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) ---
POSTGRES_USER=avd
POSTGRES_PASSWORD=avd
POSTGRES_DB=avd
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://avd:avd@localhost:5432/avd

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO / S3) ---
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=avd-assets
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# --- Authentication (OIDC) ---
# In development, use the built-in deterministic test identity provider.
AUTH_ISSUER=http://localhost:8000/auth
AUTH_AUDIENCE=ai-video-director
AUTH_JWKS_URL=http://localhost:8000/.well-known/jwks.json
AUTH_ALGORITHM=RS256
